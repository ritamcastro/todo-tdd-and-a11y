    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
